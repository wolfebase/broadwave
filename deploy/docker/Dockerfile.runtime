FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg xz-utils ca-certificates intel-media-va-driver \
  && rm -rf /var/lib/apt/lists/*
COPY broadwave /usr/local/bin/broadwave
RUN chmod 755 /usr/local/bin/broadwave
EXPOSE 8477
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["/usr/local/bin/broadwave", "-healthcheck"]
ENTRYPOINT ["/usr/local/bin/broadwave"]
CMD ["-config", "/config", "-addr", ":8477"]
