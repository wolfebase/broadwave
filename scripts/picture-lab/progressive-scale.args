# gpu-decode
# Keep a progressive picture on the iGPU. Do not deinterlace. Do not upscale.
-map 0:v:0 -map 0:a:0?
-vf scale_vaapi=w='min(1280,iw)':h='min(720,ih)':force_original_aspect_ratio=decrease
-c:v h264_vaapi -rc_mode VBR -profile:v high -bf 2 -low_power 0 -b:v 5M -maxrate 5M -bufsize 10M -g 120
-c:a aac -ac 2 -b:a 160k
